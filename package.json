{
  "name": "solarnetwork-web-api-sampler",
  "version": "2.2.0",
  "description": "SolarNetwork API explorer.",
  "keywords": [
    "solarnetwork",
    "solarquery"
  ],
  "homepage": "https://github.com/SolarNetwork/web-api-sampler",
  "license": "Apache-2.0",
  "author": {
    "name": "SolarNetwork Foundation",
    "email": "code@solarnetwork.net"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SolarNetwork/web-api-sampler.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint --fix src/main",
    "prettier": "prettier --config .prettierrc.json \"src/**/*.ts\" \"src/main/**/*.html\" --check",
    "prettier:write": "prettier --config .prettierrc.json \"src/**/*.ts\" \"src/main/**/*.html\" --write",
    "release": "release-it"
  },
  "ava": {
    "files": [
      "src/test/ts/**/*"
    ],
    "typescript": {
      "rewritePaths": {
        "src/": "lib/"
      },
      "compile": "tsc"
    }
  },
  "c8": {
    "exclude": [
      "src/test/ts/**"
    ],
    "exclude-after-remap": true,
    "reporter": [
      "text",
      "html"
    ]
  },
  "dependencies": {
    "@andypf/json-viewer": "^2.8.0",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "crypto-js": "^4.2.0",
    "highlight.js": "^11.12.0",
    "jquery": "^4.0.0",
    "solarnetwork-api-core": "^3.5.0"
  },
  "devDependencies": {
    "@ava/typescript": "^7.0.0",
    "@eslint/js": "^10.0.1",
    "@types/bootstrap": "^5.2.11",
    "@types/crypto-js": "^4.2.2",
    "@types/jquery": "^4.0.1",
    "ava": "^8.0.1",
    "c8": "^12.0.0",
    "eslint": "^10.11.0",
    "prettier": "3.9.8",
    "release-it": "^21.1.0",
    "sass": "^1.104.1",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0"
  },
  "overrides": {
    "lodash": "^4.18.1",
    "semver": "^7.8.5"
  }
}
